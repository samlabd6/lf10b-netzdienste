route:
  receiver: notify
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: notify
{% if alert_discord_webhook and alert_discord_webhook != 'CHANGE_ME' %}
    discord_configs:
      - webhook_url: "{{ alert_discord_webhook }}"
        send_resolved: true
{% endif %}
{% if alert_email_to %}
    email_configs:
      - to: "{{ alert_email_to }}"
        from: "{{ alert_email_from }}"
        smarthost: "{{ alert_smtp_host }}"
        auth_username: "{{ alert_smtp_user }}"
        auth_password: "{{ vault_smtp_password }}"
        send_resolved: true
{% endif %}

